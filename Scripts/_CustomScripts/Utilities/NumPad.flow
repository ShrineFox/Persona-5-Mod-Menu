// Item Model Banks
int bank_bg; // bg
int bank_sel; // highlighted digit
int bank1; // digit 1
int bank2; // digit 2
int bank3; // digit 3
int bank4; // digit 4
int bank5; // digit 5
int bank6; // digit 6

int highlightedDigit; // currently highlighted digit
int lastEnteredDigit; // last confirmed digit entry
int currentDigitsPlace; // digits place currently being selected

// Entered Digit Values
int digit1;
int digit2;
int digit3;
int digit4;
int digit5;
int digit6;

int Call_NumPad(int digitCount)
{
    SetupNumPad();
    
    while (true)
    {
        lastEnteredDigit = SelectNumPadValue();

        if (lastEnteredDigit == -2) break; // User confirmed entry
		else if (lastEnteredDigit == -1) // Back button pressed
		{
			// Only adjust the digit place if there's a digit to move back from
			if (currentDigitsPlace > 1)
			{
				Set_Numpad_EnteredDigit();
				currentDigitsPlace--; // Move to the previous digit place
				Set_Numpad_EnteredDigit();
			}
			else
			{
				// Clear the digit in the first place if we're at the first digit
				Set_Numpad_EnteredDigit(); 
				
				// Exit numpad as the user is at the first digit and cancels all input
				break; 
			}
		}
        else
        {
            if (currentDigitsPlace <= digitCount) 
			{
				Set_Numpad_EnteredDigit();
				if (currentDigitsPlace < digitCount) 
					currentDigitsPlace++; 
			}
        }
    }

    Despawn_Numpad();
	
    return CalculateValue();
}


void SetupNumPad()
{
	Spawn_Numpad_BG();
	Spawn_Numpad_Select();
	Spawn_Numpad_EnteredDigits();
	
	ResetDigitValues();
}

void ResetDigitValues()
{
    digit1 = -1;
    digit2 = -1;
    digit3 = -1;
    digit4 = -1;
    digit5 = -1;
	digit6 = -1;
    highlightedDigit = 0;
	currentDigitsPlace = 1;
}

int CalculateValue()
{
    int number = 0;
    int multiplier = 1;

    if (digit6 != -1) { number += digit6 * multiplier; multiplier *= 10; }
    if (digit5 != -1) { number += digit5 * multiplier; multiplier *= 10; }
    if (digit4 != -1) { number += digit4 * multiplier; multiplier *= 10; }
    if (digit3 != -1) { number += digit3 * multiplier; multiplier *= 10; }
    if (digit2 != -1) { number += digit2 * multiplier; multiplier *= 10; }
    if (digit1 != -1) { number += digit1 * multiplier; }
	
	if (digit1 == -1 && digit2 == -1 && digit3 == -1 && digit4 == -1 && digit5 == -1 && digit6 == -1)
		return -1;
	
    return number;
}


int SelectNumPadValue()
{
	Set_Digit_Anim(bank_sel, highlightedDigit);
    while (PAD_CHK_PRESS(PadButton.Any)) { SYNC(); }
    bool reload = false;
    while (true)
    {
        if (reload)
        {
            Set_Digit_Anim(bank_sel, highlightedDigit);
            reload = false;
        }
        if (PAD_CHK_PRESS(PadButton.Any))
        {
            if (PAD_CHK_TRIG(PadButton.Up))
            {
                COMSE_PLAY(0);
                reload = true;
                if (highlightedDigit == 8)
                    highlightedDigit = 0;
                else if (highlightedDigit > 0)
                {
                    if (highlightedDigit < 7)
                        highlightedDigit += 3;
                    else
                        highlightedDigit -= 6;
                }
                else
                    highlightedDigit = 2;
            }
            else if (PAD_CHK_TRIG(PadButton.Down))
            {
                COMSE_PLAY(0);
                reload = true;
                if (highlightedDigit == 2)
                    highlightedDigit = 0;
                else if (highlightedDigit > 0)
                {
                    if (highlightedDigit > 3)
                    {
                        highlightedDigit -= 3;
                    }
                    else
                        highlightedDigit += 6;
                }
                else
                    highlightedDigit = 8;
            }
            else if (PAD_CHK_TRIG(PadButton.Right))
            {
                COMSE_PLAY(0);
                reload = true;
                if (highlightedDigit == 0)
                    highlightedDigit = 3;
                else if (highlightedDigit != 3 && highlightedDigit != 6 && highlightedDigit != 9)
                    highlightedDigit += 1;
                else
                    highlightedDigit -= 2;
            }
            else if (PAD_CHK_TRIG(PadButton.Left))
            {
                COMSE_PLAY(0);
                reload = true;
                if (highlightedDigit == 0)
                    highlightedDigit = 1;
                else if (highlightedDigit != 1 && highlightedDigit != 4 && highlightedDigit != 7)
                    highlightedDigit -= 1;
                else
                    highlightedDigit += 2;
            }
            else if (PAD_CHK_TRIG(PadButton.Cross))
            {
                COMSE_PLAY(2); // back
                return -1;
            }
            else if (PAD_CHK_TRIG(PadButton.Circle))
            {
                COMSE_PLAY(1); // enter
                return highlightedDigit;
            }
            else if (PAD_CHK_TRIG(PadButton.Start))
            {
                return -2;
            }
        }
        SYNC();
    }
    return -3;
}


int SpawnModel(int majorID, int minorID)
{
	int resHandle = FLD_ITEM_MODEL_LOAD(majorID, minorID);
	FLD_MODEL_LOADSYNC(resHandle);
	FLD_MODEL_SET_VISIBLE(resHandle, 1, 0);
	SYNC();
	
	return resHandle;
}

void DespawnModel(int resHandle)
{
    FLD_MODEL_FREE(resHandle);
	SYNC();
}


void Spawn_Numpad_BG()
{
    DespawnModel(bank_bg);
	bank_bg = SpawnModel(8000, 99);
}

void Spawn_Numpad_Select()
{
    DespawnModel(bank_sel);
	bank_sel = SpawnModel(8000, 100);
}

void Spawn_Numpad_EnteredDigits()
{
    DespawnModel(bank1);
	bank1 = SpawnModel(8000, 101);
	FLD_MODEL_SET_VISIBLE(bank1, 0, 0);
	DespawnModel(bank2);
	bank2 = SpawnModel(8000, 102);
	FLD_MODEL_SET_VISIBLE(bank2, 0, 0);
	DespawnModel(bank3);
	bank3 = SpawnModel(8000, 103);
	FLD_MODEL_SET_VISIBLE(bank3, 0, 0);
	DespawnModel(bank4);
	bank4 = SpawnModel(8000, 104);
	FLD_MODEL_SET_VISIBLE(bank4, 0, 0);
	DespawnModel(bank5);
	bank5 = SpawnModel(8000, 105);
	FLD_MODEL_SET_VISIBLE(bank5, 0, 0);
	DespawnModel(bank6);
	bank6 = SpawnModel(8000, 106);
	FLD_MODEL_SET_VISIBLE(bank6, 0, 0);
}

void Despawn_Numpad()
{
	DespawnModel(bank_bg);
	DespawnModel(bank_sel);
	DespawnModel(bank1);
	DespawnModel(bank2);
	DespawnModel(bank3);
	DespawnModel(bank4);
	DespawnModel(bank5);
	DespawnModel(bank6);
}

void Set_Numpad_EnteredDigit()
{
    switch (currentDigitsPlace)
    {
        case 1: digit1 = lastEnteredDigit; Set_Digit_Anim(bank1, lastEnteredDigit); break;
        case 2: digit2 = lastEnteredDigit; Set_Digit_Anim(bank2, lastEnteredDigit); break;
        case 3: digit3 = lastEnteredDigit; Set_Digit_Anim(bank3, lastEnteredDigit); break;
        case 4: digit4 = lastEnteredDigit; Set_Digit_Anim(bank4, lastEnteredDigit); break;
        case 5: digit5 = lastEnteredDigit; Set_Digit_Anim(bank5, lastEnteredDigit); break;
        case 6: digit6 = lastEnteredDigit; Set_Digit_Anim(bank6, lastEnteredDigit); break;
    }
	
	// PrintNumPadDebug();
}


void PrintNumPadDebug()
{
	PUTS("Currently highlighted digit:");
	PUT(highlightedDigit);
	PUTS("Last confirmed digit entry:");
	PUT(lastEnteredDigit);
	PUTS("Digits place currently being selected:");
	PUT(currentDigitsPlace);

	PUTS("Current Entered Value:");
	PUT(digit1);
	PUT(digit2);
	PUT(digit3);
	PUT(digit4);
	PUT(digit5);
	PUT(digit6);
}

void Set_Digit_Anim(int resHandle, int animID)
{
	if (animID == -1)
		FLD_MODEL_SET_VISIBLE(resHandle, 0, 0); // hide model
	else
		FLD_MODEL_SET_VISIBLE(resHandle, 1, 0); // show model
	
	FLD_MODEL_ANIM( resHandle, animID, 1, 1, 1.00f );
}