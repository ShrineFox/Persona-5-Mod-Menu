// Item Model Banks
int bank0; // bg
int bank1; // highlighted digit
int bank2; // digit 1
int bank3; // digit 2
int bank4; // digit 3
int bank5; // digit 4
int bank6; // digit 5

int highlightedDigit; // currently highlighted digit
int lastEnteredDigit; // last confirmed digit entry

// Entered Digit Values
int digit1;
int digit2;
int digit3;
int digit4;
int digit5;

int Call_NumPad(int digitCount)
{
    ShowNumPadBG();
    ResetDigitValues();
    
    int i = 0; // current digits place being selected

    while (i < digitCount)
    {
        lastEnteredDigit = SelectNumPadValue();

		if (lastEnteredDigit == -3) // error
        {
            PUTS("NumPad Error");
            break;
        }
        if (lastEnteredDigit == -2) // user ended entry with select button
        {
            digitCount = i; // Set final digit count for calculating value
            break;
        }
        else if (lastEnteredDigit == -1) // user pressed back button
        {
            if (i > 0)
            {
                i--; // Move back one digit
                UpdateConfirmedDigits(i);
				continue; // Prevent i from increasing again
            }
            else
            {
                break; // Exit numpad if back is pressed on first digit
            }
        }
        else
        {
            UpdateConfirmedDigits(i);

			if (i < digitCount - 2)
				i++; // Move to the next digit
        }
    }

    HideNumPad();
	
    return CalculateValue(digitCount);
}

void ResetDigitValues()
{
    digit1 = -1;
    digit2 = -1;
    digit3 = -1;
    digit4 = -1;
    digit5 = -1;
    highlightedDigit = 0;
}

void UpdateConfirmedDigits(int currentSlot)
{
    // Remove the previous digit in the current slot before updating it
    if (currentSlot == 0) HideValueDigit(1, digit1);
    if (currentSlot == 1) HideValueDigit(2, digit2);
    if (currentSlot == 2) HideValueDigit(3, digit3);
    if (currentSlot == 3) HideValueDigit(4, digit4);
    if (currentSlot == 4) HideValueDigit(5, digit5);

    // Update only the current slot with the new entered digit
    switch (currentSlot)
    {
        case 0: digit1 = lastEnteredDigit; ShowValueDigit(1, digit1); break;
        case 1: digit2 = lastEnteredDigit; ShowValueDigit(2, digit2); break;
        case 2: digit3 = lastEnteredDigit; ShowValueDigit(3, digit3); break;
        case 3: digit4 = lastEnteredDigit; ShowValueDigit(4, digit4); break;
        case 4: digit5 = lastEnteredDigit; ShowValueDigit(5, digit5); break;
    }
}

int CalculateValue(int digitCount)
{
    int number = 0;
    int multiplier = 1;

    if (digitCount == 5) { number += digit5 * multiplier; multiplier *= 10; }
    if (digitCount >= 4) { number += digit4 * multiplier; multiplier *= 10; }
    if (digitCount >= 3) { number += digit3 * multiplier; multiplier *= 10; }
    if (digitCount >= 2) { number += digit2 * multiplier; multiplier *= 10; }
    if (digitCount >= 1) { number += digit1 * multiplier; }

	COMSE_PLAY(3); // chime
    return number;
}

int SelectNumPadValue()
{
    ShowHighlightedDigit();
    while (PAD_CHK_PRESS(PadButton.Any)) { SYNC(); }
    bool reload = false;
    while (true)
    {
        if (reload)
        {
            ShowHighlightedDigit();
            reload = false;
        }
        if (PAD_CHK_PRESS(PadButton.Any))
        {
            if (PAD_CHK_TRIG(PadButton.Up))
            {
                COMSE_PLAY(0);
                HideHighlightedDigit();
                reload = true;
                if (highlightedDigit == 8)
                    highlightedDigit = 0;
                else if (highlightedDigit > 0)
                {
                    if (highlightedDigit < 7)
                        highlightedDigit += 3;
                    else
                        highlightedDigit -= 6;
                }
                else
                    highlightedDigit = 2;
            }
            else if (PAD_CHK_TRIG(PadButton.Down))
            {
                COMSE_PLAY(0);
                HideHighlightedDigit();
                reload = true;
                if (highlightedDigit == 2)
                    highlightedDigit = 0;
                else if (highlightedDigit > 0)
                {
                    if (highlightedDigit > 3)
                    {
                        highlightedDigit -= 3;
                    }
                    else
                        highlightedDigit += 6;
                }
                else
                    highlightedDigit = 8;
            }
            else if (PAD_CHK_TRIG(PadButton.Right))
            {
                COMSE_PLAY(0);
                HideHighlightedDigit();
                reload = true;
                if (highlightedDigit == 0)
                    highlightedDigit = 3;
                else if (highlightedDigit != 3 && highlightedDigit != 6 && highlightedDigit != 9)
                    highlightedDigit += 1;
                else
                    highlightedDigit -= 2;
            }
            else if (PAD_CHK_TRIG(PadButton.Left))
            {
                COMSE_PLAY(0);
                HideHighlightedDigit();
                reload = true;
                if (highlightedDigit == 0)
                    highlightedDigit = 1;
                else if (highlightedDigit != 1 && highlightedDigit != 4 && highlightedDigit != 7)
                    highlightedDigit -= 1;
                else
                    highlightedDigit += 2;
            }
            else if (PAD_CHK_TRIG(PadButton.Cross))
            {
                COMSE_PLAY(2); // back
                HideHighlightedDigit();
                return -1;
            }
            else if (PAD_CHK_TRIG(PadButton.Circle))
            {
                COMSE_PLAY(1); // enter
                HideHighlightedDigit();
                return highlightedDigit;
            }
            else if (PAD_CHK_TRIG(PadButton.Select))
            {
                HideHighlightedDigit();
                return -2;
            }
        }
        SYNC();
    }
    return -3;
}

void ShowHighlightedDigit()
{
    SpawnPadModel(1, 100 + highlightedDigit);
    SYNC();
}

void HideHighlightedDigit()
{
    DespawnPadModel(1);
    SYNC();
}


void ShowValueDigit(int position, int value)
{
    if (value != -1)
    {
        // i.e. digit 4, selected 2 = 132
        int dds = 100 + (10 * position) + value;
        SpawnPadModel(position + 1, dds);
    }
    SYNC();
}

void HideValueDigit(int position, int value)
{
    if (value != -1)
    {
        DespawnPadModel(position + 1);
    }
    SYNC();
}

void ShowNumPadBG()
{
	// Show Numpad BG
    SpawnPadModel(0, 99);
    SYNC();
}

void HideNumPad()
{
	// Hide Numpad BG
    FLD_MODEL_FREE(bank0);
    SYNC();
	
	// Hide All Value Digits
	if (digit1 != -1) HideValueDigit(1, digit1);
    if (digit2 != -1) HideValueDigit(2, digit2);
    if (digit3 != -1) HideValueDigit(3, digit3);
    if (digit4 != -1) HideValueDigit(4, digit4);
    if (digit5 != -1) HideValueDigit(5, digit5);
}

void SpawnPadModel(int bankId, int itemId)
{
    PUTS("Bank ID:"); PUT(bankId);
    PUTS("Item ID:"); PUT(itemId);

    int jokerHandle = FLD_PC_GET_RESHND(0);

    if (bankId == 0) FLD_MODEL_FREE(bank0);
    else if (bankId == 1) FLD_MODEL_FREE(bank1);
    else if (bankId == 2) FLD_MODEL_FREE(bank2);
    else if (bankId == 3) FLD_MODEL_FREE(bank3);
    else if (bankId == 4) FLD_MODEL_FREE(bank4);
    else if (bankId == 5) FLD_MODEL_FREE(bank5);
    else if (bankId == 6) FLD_MODEL_FREE(bank6);
	SYNC();
	
    int gmd = FLD_ITEM_MODEL_LOAD(8000, itemId);
    FLD_MODEL_LOADSYNC(gmd);
    FLD_MODEL_ATTACH_TRANSLATE(gmd, jokerHandle, 0);
    FLD_MODEL_SET_VISIBLE(gmd, 1, 0);
	SYNC();
	
    if (bankId == 0) bank0 = gmd;
    else if (bankId == 1) bank1 = gmd;
    else if (bankId == 2) bank2 = gmd;
    else if (bankId == 3) bank3 = gmd;
    else if (bankId == 4) bank4 = gmd;
    else if (bankId == 5) bank5 = gmd;
    else if (bankId == 6) bank6 = gmd;
}

void DespawnPadModel(int bankId)
{
    if (bankId == 0) FLD_MODEL_FREE(bank0);
    else if (bankId == 1) FLD_MODEL_FREE(bank1);
    else if (bankId == 2) FLD_MODEL_FREE(bank2);
    else if (bankId == 3) FLD_MODEL_FREE(bank3);
    else if (bankId == 4) FLD_MODEL_FREE(bank4);
    else if (bankId == 5) FLD_MODEL_FREE(bank5);
    else if (bankId == 6) FLD_MODEL_FREE(bank6);
}